# Copy to .env in the repository root. All values are optional.
APP_NAME=Customer Churn Intelligence
ENVIRONMENT=development
# sqlite:///C:/path/to/app.db   or   postgresql+psycopg://user:pass@localhost:5432/churn
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_PATH=
METADATA_PATH=
SEGMENTS_PATH=
DATA_CSV_PATH=
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
AUTO_IMPORT=true
# Frontend only. Leave empty to use the Vite dev proxy.
VITE_API_URL=
# Node-side Vite proxy target. Used by `npm run dev`, not by the browser bundle.
VITE_API_PROXY=http://localhost:8000
